# Domain utama website (untuk meta tags, sitemap, dan canonical URL)
NEXT_PUBLIC_SITE_URL=https://rentaltaman.netlify.app

# Google Analytics 4 Measurement ID (opsional jika ingin tracking)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Search Console Verification Meta Tag (opsional jika menggunakan file HTML verifikasi dari GSC)
NEXT_PUBLIC_GSC_VERIFICATION=your-google-site-verification-code
